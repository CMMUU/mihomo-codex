{
  "name": "routedeck",
  "private": true,
  "version": "0.6.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "core:prepare": "node scripts/prepare-mihomo.mjs",
    "core:prepare:all": "node scripts/prepare-mihomo.mjs --all",
    "test:core": "npm run core:prepare && node scripts/smoke-mihomo.mjs",
    "check": "npm run test:branding && npm run test:licenses && npm run test:theme && npm run test:rules && npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:branding": "node scripts/check-branding.mjs",
    "test:licenses": "node scripts/check-licenses.mjs",
    "test:theme": "node --test tests/theme.test.mjs",
    "test:rules": "node --test tests/rules.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "fflate": "^0.8.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
